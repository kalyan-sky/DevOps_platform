# Copy to .env for local testing, or set these as Cloud Run environment
# variables / secrets in production. Leave WhatsApp vars unset to run in
# "dry run" mode (messages are logged instead of sent) for local dev.

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO_NUMBER=
WHATSAPP_TEMPLATE_NAME=new_site_message
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-yourself

# --- Storage ---
# Set to "false" to force the in-memory store (local dev only — not safe for
# production, since state is lost on restart and isn't shared across
# instances). Leave unset/true in production so it uses Firestore.
USE_FIRESTORE=false

# --- CORS ---
# Your deployed site's origin, e.g. https://your-site.example.com
ALLOWED_ORIGIN=*
